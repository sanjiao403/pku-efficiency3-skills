{
  "what": "real two-arm comparison on identical case inputs (mechanism check, NOT a platform score)",
  "arms": {
    "baseline": "paragraph-order paste, fixed 14pt, no locator, notes = page text",
    "skill": "scripts/run.py (this package)"
  },
  "shared": [
    "material reader (papertext.py)",
    "renderer (render.py)",
    "measurement (benchmark_local.measure)",
    "auditor (audit_deck.py)"
  ],
  "environment": {
    "python": "3.14.3",
    "platform": "Windows",
    "model_requests": 0,
    "note": "both arms are deterministic code; no model is called in either arm, so the elapsed-time delta is pure wall clock"
  },
  "commands": [
    "python3 scripts/run.py --case <case.json> --out <T>/skill",
    "python3 scripts/benchmark_local.py --reps 3",
    "python3 scripts/audit_deck.py --out <T>/<arm> --case <case.json>"
  ],
  "metrics": [
    {
      "key": "slides",
      "label": "页数",
      "field": "cases[i].{arm}.slides",
      "aggregation": "sum"
    },
    {
      "key": "page_budget_ok",
      "label": "页数不超上限",
      "field": "cases[i].{arm}.page_budget_ok",
      "aggregation": "mean"
    },
    {
      "key": "page_budget_over_by",
      "label": "超出页数预算",
      "field": "cases[i].{arm}.page_budget_over_by",
      "aggregation": "sum"
    },
    {
      "key": "verifiable_elements",
      "label": "可核验图元数（数字 + 图/表号）",
      "field": "cases[i].{arm}.verifiable_elements",
      "aggregation": "sum"
    },
    {
      "key": "source_traceability",
      "label": "来源可追率（逐字回查命中）",
      "field": "cases[i].{arm}.source_traceability",
      "aggregation": "mean"
    },
    {
      "key": "caption_number_consistency",
      "label": "图注-数值一致率",
      "field": "cases[i].{arm}.caption_number_consistency",
      "aggregation": "mean"
    },
    {
      "key": "layout_violations",
      "label": "布局/溢出违规数",
      "field": "cases[i].{arm}.layout_violations",
      "aggregation": "sum"
    },
    {
      "key": "max_page_chars",
      "label": "单页最多字符数",
      "field": "cases[i].{arm}.max_page_chars",
      "aggregation": "sum"
    },
    {
      "key": "notes_echo_pages",
      "label": "备注复述页数",
      "field": "cases[i].{arm}.notes_echo_pages",
      "aggregation": "sum"
    },
    {
      "key": "content_pages_located",
      "label": "已核实 locator 的内容页",
      "field": "cases[i].{arm}.content_pages_located",
      "aggregation": "sum"
    },
    {
      "key": "locator_rate",
      "label": "来源定位覆盖率",
      "field": "cases[i].{arm}.locator_rate",
      "aggregation": "mean"
    },
    {
      "key": "audit_deck_failed",
      "label": "独立审计失败项数",
      "field": "cases[i].{arm}.audit_deck_failed",
      "aggregation": "sum"
    },
    {
      "key": "e2e_seconds",
      "label": "端到端耗时（秒）",
      "field": "cases[i].{arm}.e2e_seconds",
      "aggregation": "sum"
    }
  ],
